APP_NAME=Convoy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma-separated IPs/CIDRs for reverse proxies whose forwarded client-IP headers Convoy may
# trust. Leave unset when clients connect directly; never use * on an internet-facing origin.
TRUSTED_PROXIES=

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_MAINTENANCE_DRIVER=cache

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=convoy
DB_USERNAME=convoy_user
DB_PASSWORD=

CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# spatie/laravel-settings: cache resolved settings so reads don't hit the DB.
# Invalidated automatically on save. Leave enabled in production.
SETTINGS_CACHE_ENABLED=true
SESSION_DRIVER=redis
SESSION_LIFETIME=525600

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PHP_XDEBUG=false
PHP_XDEBUG_MODE='debug'
# Optional: VictoriaMetrics endpoint for admin dashboard metric history (deltas + sparklines).
# Leave unset to disable — the dashboard works without it.
VICTORIAMETRICS_URL=

# Optional: single sign-on deep links (mint via POST /api/application/users/{user}/generate-sso-token).
# SSO_LINK_TTL is the signed-link lifetime in seconds; SSO_AUDIT_CHANNEL is the log channel each
# consumed link is written to (defaults to LOG_CHANNEL). Both have sensible defaults.
SSO_LINK_TTL=60
SSO_AUDIT_CHANNEL=

# Optional: OAuth / OIDC federated login (Convoy as Relying Party — see config/oauth.php).
# A provider only appears on the login screen when its *_ENABLED flag is true AND its client
# id/secret are set. OAUTH_REGISTRATION auto-creates a (non-admin) user for an unknown identity;
# OAUTH_LINK_BY_VERIFIED_EMAIL links a provider identity to an existing user by verified email.
OAUTH_REGISTRATION=false
OAUTH_LINK_BY_VERIFIED_EMAIL=true
# OAUTH_GOOGLE_ENABLED=true
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_ENABLED=true
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITLAB_ENABLED=true
# OAUTH_GITLAB_CLIENT_ID=
# OAUTH_GITLAB_CLIENT_SECRET=
# Generic OpenID Connect against any standards-compliant IdP (Keycloak, Authentik, Okta, …).
# OAUTH_OIDC_BASE_URL is the issuer; endpoints are read from its /.well-known/openid-configuration.
# OAUTH_OIDC_LABEL is the login-button text. OAUTH_OIDC_SCOPES (comma list) is optional; openid is
# always requested. OAUTH_OIDC_{AUTH,TOKEN,USERINFO}_URL only needed if discovery is non-standard.
# OAUTH_OIDC_ENABLED=true
# OAUTH_OIDC_LABEL="Company SSO"
# OAUTH_OIDC_BASE_URL=https://idp.example.com/realms/main
# OAUTH_OIDC_CLIENT_ID=
# OAUTH_OIDC_CLIENT_SECRET=
# OAUTH_OIDC_SCOPES=profile,email
