{$APP_URL} {
    root * /var/www/public
    php_fastcgi php:9000
    encode gzip
    file_server

    @static {
        file
        path *.ico *.css *.js *.gif *.webp *.avif *.jpg *.jpeg *.png *.svg *.woff *.woff2
    }
    header @static Cache-Control max-age=5184000

    # Via is what Caddy 2.11's php_fastcgi adds to every PHP response.
    header {
        -Server
        -Via
        -X-Powered-By
    }
}