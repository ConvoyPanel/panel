includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    stubFiles:
        # Spatie QueryBuilder forwards Eloquent builder calls through __call();
        # PHPStan cannot infer those fluent methods from the package itself.
        - stubs/spatie-query-builder.stub

    paths:
        - app/

    # Level 10 is the highest level
    level: 5

#    ignoreErrors:
#        - '#PHPDoc tag @var#'
#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php
